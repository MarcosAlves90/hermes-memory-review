{
  "schema_version": 6,
  "kind": "behavior_preserving",
  "scope": {
    "allowed_paths": [
      "README.md",
      "tests/test_desktop.py"
    ]
  },
  "test_scope": {
    "allowed_paths": [
      "tests/test_desktop.py"
    ]
  },
  "development_method": "strict_sdd_tdd_v2",
  "specification": {
    "objective": "Document the repository-retained POLIS workflow for Magi without changing runtime behavior.",
    "requirements": [
      {
        "id": "REQ-001",
        "statement": "README documents that POLIS workflow artifacts are retained in the repository via .polis/artifact-retention.json."
      },
      {
        "id": "REQ-002",
        "statement": "Documentation distinguishes the newly locked contract from earlier Magi updates so no retroactive strict-development proof is implied."
      }
    ],
    "acceptance_criteria": [
      {
        "id": "AC-001",
        "statement": "README states repository retention and the non-retroactive boundary, while the existing test suite remains green.",
        "requirements": [
          "REQ-001",
          "REQ-002"
        ],
        "proof": "regression"
      }
    ],
    "invariants": [
      {
        "id": "INV-001",
        "statement": "No application or plugin runtime behavior changes."
      },
      {
        "id": "INV-002",
        "statement": "Existing POLIS policy and Hermes plugin validation semantics remain unchanged."
      }
    ],
    "forbidden_states": [
      {
        "id": "FORBID-001",
        "statement": "Do not claim that this contract validates changes committed before its locked baseline."
      }
    ],
    "inputs": [
      {
        "id": "IN-001",
        "statement": "Committed .polis/artifact-retention.json with mode=repository."
      }
    ],
    "outputs": [
      {
        "id": "OUT-001",
        "statement": "README documentation for repository-retained POLIS workflow state."
      }
    ],
    "failure_semantics": [
      {
        "id": "FAIL-001",
        "statement": "If POLIS cannot lock the contract or baseline tests fail, leave the documentation change unapplied."
      }
    ]
  },
  "baseline_lock": {
    "git_object_format": "sha1",
    "base_commit": "543990af1d46862cee64fdc8de29718f4cd32598",
    "base_tree": "637f1e8dcf639779f4f337a9aa91ac1ef01a5e19",
    "policy_sha256": "ad0c9c1e2ae90949ee1dfebaa10c98f085ef260284daae61f4fe67d7b95c2529",
    "specification_sha256": "6ff88cc329a546c22b18b6896337916ef4e4b6fcdbd19b6c5ed64cd2b8605fef"
  },
  "behavior": {
